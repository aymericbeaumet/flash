{
  "contract": "docs/plugin-protocol.md#plugin--host",
  "description": "AI Providers publishes separate fixed-width Claude and Codex quota labels and detail surfaces before cached provider refreshes complete.",
  "steps": [
    {
      "send": {
        "id": 1,
        "method": "initialize",
        "params": {
          "protocol_version": 1
        }
      }
    },
    {
      "expect": {
        "id": 1,
        "result": {
          "ok": true,
          "protocol_version": 1
        }
      },
      "within_ms": 5000
    },
    {
      "expect_notification": {
        "method": "status",
        "params": {
          "segments": {
            "claude_label": {
              "$contains": "#[fg=#EBCB8B]Cld #[fg=colour245]"
            },
            "claude_details": {
              "$contains": "Fable"
            },
            "codex_label": {
              "$contains": "#[fg=#EBCB8B]Cdx #[fg=colour245]"
            },
            "codex_details": {
              "$contains": "Astra"
            }
          }
        }
      },
      "within_ms": 5000
    },
    {
      "close_stdin": true
    },
    {
      "expect_exit": {
        "code": 0
      },
      "within_ms": 3000
    }
  ]
}
