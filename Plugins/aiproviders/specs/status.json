{
  "contract": "docs/plugin-protocol.md#plugin--host",
  "description": "AI Providers immediately publishes one popup-backed compact summary and one aligned Claude/Fable/OpenAI/Astra detail surface before cached provider refreshes complete.",
  "steps": [
    {
      "send": { "id": 1, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 5000
    },
    {
      "expect_notification": {
        "method": "status",
        "params": {
          "segments": {
            "summary": {
              "$contains": "]#[fg=colour178]AI#[default]#[nopopup]"
            },
            "details": {
              "$contains": "#[fg=colour245]  Astra   5-hour"
            }
          }
        }
      },
      "within_ms": 5000
    },
    { "close_stdin": true },
    { "expect_exit": { "code": 0 }, "within_ms": 3000 }
  ]
}
