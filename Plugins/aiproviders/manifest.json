{
  "id": "aiproviders",
  "name": "AI Providers",
  "version": "0.1.0",
  "description": "Open AI chat providers from the flashlight and publish Claude and Codex quota labels plus a summary of both subscriptions' quotas.",
  "exec": [
    "./flash-plugin-aiproviders"
  ],
  "bangs": {
    "command": "aiproviders",
    "items": [
      {
        "token": "chatgpt",
        "description": "Open ChatGPT (pre-fills query if provided)"
      },
      {
        "token": "claude",
        "description": "Open Claude (pre-fills query if provided)"
      },
      {
        "token": "gemini",
        "description": "Open Gemini (pre-fills query if provided)"
      },
      {
        "token": "perplexity",
        "description": "Open Perplexity search"
      },
      {
        "token": "copilot",
        "description": "Open Microsoft Copilot"
      },
      {
        "token": "grok",
        "description": "Open Grok (xAI)"
      }
    ]
  },
  "status": [
    "claude_label",
    "codex_label",
    "details"
  ],
  "capabilities": [
    "open",
    "network",
    "subprocess"
  ]
}
