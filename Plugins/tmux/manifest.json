{
  "id": "tmux",
  "name": "tmux",
  "version": "0.1.0",
  "description": "Hints tmux panes/links and exposes a tmux window finder.",
  "install": "true",
  "exec": ["./flash-plugin-tmux"],
  "capabilities": [
    "subprocess",
    "accessibility",
    "app_control"
  ],
  "priority": 20,
  "volatile": true,
  "request_timeout_ms": 8000,
  "hints": {
    "fallback_on_empty": true
  },
  "commands": {
    "items": [
      {
        "command": "tmux",
        "subcommand": "session",
        "description": "Switch the active tmux client to a session by name and raise its terminal."
      },
      {
        "command": "tmux",
        "subcommand": "window",
        "description": "Switch the active tmux client to a session:window target and raise its terminal."
      }
    ]
  },
  "navigation": {
    "schemes": [
      "tmux"
    ]
  },
  "listen": [
    "core:focus.changed",
    "core:window.focus.changed",
    "core:apps.terminated"
  ],
  "sources": [
    {
      "name": "tmux.windows",
      "kind": "locations",
      "priority": "high"
    }
  ],
  "source_actions": [
    "tab_select",
    "tab_next",
    "tab_prev",
    "tab_first",
    "tab_last",
    "tab_new",
    "tab_close",
    "tab_move_previous",
    "tab_move_next",
    "pane_next",
    "pane_previous",
    "pane_split_vertical",
    "pane_split_horizontal",
    "pane_close",
    "app_reload"
  ]
}
