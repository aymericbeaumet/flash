{
  "id": "tmux",
  "name": "tmux",
  "version": "0.1.0",
  "description": "Hints tmux panes/links, exposes a tmux window finder, and publishes session/window/pane statusbar segments.",
  "exec": [
    "./flash-plugin-tmux"
  ],
  "capabilities": [
    "subprocess",
    "accessibility",
    "app_control"
  ],
  "priority": 20,
  "hints": {
    "fallback_on_empty": true
  },
  "commands": [
    {
      "command": "tmux",
      "subcommand": "session",
      "description": "Switch the active tmux client to a session by name and raise its terminal."
    },
    {
      "command": "tmux",
      "subcommand": "window",
      "description": "Switch the active tmux client to a session:window target and raise its terminal."
    }
  ],
  "navigation": [
    "tmux"
  ],
  "status": [
    "session",
    "window",
    "pane"
  ],
  "listen": [
    "core:focus.changed",
    "core:window.focus.changed",
    "core:apps.terminated"
  ],
  "sources": [
    {
      "name": "tmux.windows",
      "kind": "locations",
      "priority": "high"
    }
  ],
  "actions": [
    "tab_select",
    "tab_next",
    "tab_prev",
    "tab_first",
    "tab_last",
    "tab_new",
    "tab_close",
    "tab_move_previous",
    "tab_move_next",
    "pane_next",
    "pane_previous",
    "pane_split_vertical",
    "pane_split_horizontal",
    "pane_close",
    "app_reload"
  ]
}
