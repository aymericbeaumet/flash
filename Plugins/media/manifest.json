{
  "id": "media",
  "name": "Media",
  "version": "0.1.0",
  "description": "System media controls, now-playing info, and audio device selection.",
  "sandbox": {
    "exec": [
      "/usr/bin/osascript"
    ],
    "appleevents": true
  },
  "exec": [
    "./flash-plugin-media"
  ],
  "commands": [
    {
      "command": "media",
      "subcommand": "play",
      "description": "Resume playback in the active media app"
    },
    {
      "command": "media",
      "subcommand": "pause",
      "description": "Pause playback in the active media app"
    },
    {
      "command": "media",
      "subcommand": "toggle",
      "description": "Toggle play/pause in the active media app"
    },
    {
      "command": "media",
      "subcommand": "next",
      "description": "Skip to next track"
    },
    {
      "command": "media",
      "subcommand": "previous",
      "description": "Skip to previous track"
    },
    {
      "command": "media",
      "subcommand": "volumeup",
      "description": "Raise system output volume"
    },
    {
      "command": "media",
      "subcommand": "volumedown",
      "description": "Lower system output volume"
    },
    {
      "command": "media",
      "subcommand": "mute",
      "description": "Toggle system output mute"
    },
    {
      "command": "media",
      "subcommand": "get",
      "description": "Report the currently playing track"
    },
    {
      "command": "media",
      "subcommand": "status",
      "description": "Report which media apps are running and their state"
    },
    {
      "command": "media",
      "subcommand": "input",
      "description": "List or select the default audio input device by name or UID"
    },
    {
      "command": "media",
      "subcommand": "output",
      "description": "List or select the default audio output device by name or UID"
    },
    {
      "command": "media",
      "subcommand": "run",
      "description": "Run osascript with raw arguments"
    }
  ],
  "verbs": [
    {
      "name": "media_input",
      "command": "media",
      "subcommand": "input",
      "description": "List or select the default audio input device (--device=name-or-UID)"
    },
    {
      "name": "media_output",
      "command": "media",
      "subcommand": "output",
      "description": "List or select the default audio output device (--device=name-or-UID)"
    }
  ],
  "capabilities": [
    "media_keys",
    "audio_devices"
  ]
}
