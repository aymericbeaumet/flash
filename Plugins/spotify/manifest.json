{
  "id": "spotify",
  "name": "Spotify",
  "version": "0.1.0",
  "description": "Spotify playback controls backed by spotify_player.",
  "install": "./install.sh",
  "start": "./start.sh",
  "events": [
    { "match": "apps.*", "bundle_ids": ["com.spotify.client"] },
    "config.*"
  ],
  "actions": [
    { "command": "spotify", "name": "login", "description": "Authenticate spotify_player" },
    { "command": "spotify", "name": "status", "description": "Show spotify_player version/status" },
    { "command": "spotify", "name": "pause", "description": "Pause playback" },
    { "command": "spotify", "name": "play", "description": "Resume playback" },
    { "command": "spotify", "name": "toggle", "description": "Toggle play/pause" },
    { "command": "spotify", "name": "next", "description": "Skip to next track" },
    { "command": "spotify", "name": "previous", "description": "Skip to previous track" },
    { "command": "spotify", "name": "search", "description": "Search Spotify" },
    { "command": "spotify", "name": "run", "description": "Run spotify_player with raw arguments" }
  ]
}
