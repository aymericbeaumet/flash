{
  "manifest_version": 1,
  "id": "clipboard",
  "name": "Clipboard",
  "version": "0.1.0",
  "description": "Clipboard history behind :clipboard; pick an entry to paste it. Plus top-level :copy and :paste.",
  "install": "true",
  "start": "exec ./flash-plugin-clipboard",
  "subscriptions": [
    { "match": "core:clipboard.changed" }
  ],
  "capabilities": ["clipboard"],
  "providers": [
    {
      "kind": "commands",
      "commands": [
        { "command": "clipboard", "subcommand": "", "description": "Browse clipboard history" },
        { "command": "copy", "subcommand": "", "description": "Copy the selection (⌘C)" },
        { "command": "paste", "subcommand": "", "description": "Paste (⌘V)" }
      ]
    }
  ]
}
