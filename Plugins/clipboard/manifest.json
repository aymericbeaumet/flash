{
  "id": "clipboard",
  "name": "Clipboard",
  "version": "0.1.0",
  "description": "Clipboard history in flashlight; pick an entry to paste it. Plus top-level :copy and :paste.",
  "install": "true",
  "start": "exec ./flash-plugin-clipboard",
  "events": [
    "flash.started",
    { "match": "clipboard.changed" }
  ],
  "providers": [
    { "kind": "candidates" },
    {
      "kind": "commands",
      "commands": [
        { "command": "copy", "subcommand": "", "description": "Copy the selection (⌘C)" },
        { "command": "paste", "subcommand": "", "description": "Paste (⌘V)" }
      ]
    }
  ]
}
