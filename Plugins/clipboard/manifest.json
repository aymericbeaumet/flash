{
  "id": "clipboard",
  "name": "Clipboard",
  "version": "0.1.0",
  "description": "Clipboard history behind :clipboard show and :clipboard delete. Records text, images, formatted copies, and file paths.",
  "sandbox": {},
  "exec": [
    "./flash-plugin-clipboard"
  ],
  "capabilities": [
    "clipboard"
  ],
  "commands": [
    {
      "command": "clipboard",
      "subcommand": "show",
      "description": "Browse clipboard history"
    },
    {
      "command": "clipboard",
      "subcommand": "delete",
      "description": "Delete one clipboard history entry"
    }
  ],
  "listen": [
    "core:clipboard.changed"
  ]
}
