{
  "manifest_version": 2,
  "id": "reminders",
  "name": "Reminders",
  "version": "0.1.0",
  "description": "Surface macOS Reminders entries in flashlight, plus `:reminders` open helper.",
  "install": "true",
  "start": "exec ./flash-plugin-reminders",
  "priority": 12,
  "subscriptions": [
    "core:flash.started",
    "core:config.*",
    {
      "match": "core:apps.*",
      "bundle_ids": [
        "com.apple.reminders"
      ]
    }
  ],
  "candidates": {
    "sources": [
      "reminders.tasks"
    ]
  },
  "commands": {
    "items": [
      {
        "command": "reminders",
        "subcommand": "open",
        "description": "Open Reminders.app"
      },
      {
        "command": "reminders",
        "subcommand": "refresh",
        "description": "Refresh the cached reminders list"
      }
    ]
  }
}
