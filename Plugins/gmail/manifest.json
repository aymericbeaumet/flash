{
  "id": "gmail",
  "name": "Gmail",
  "version": "0.1.0",
  "description": "Gmail-specific source actions and focused-URL normal-mode mappings.",
  "install": "true",
  "start": "exec ./flash-plugin-gmail",
  "priority": 60,
  "capabilities": [
    "accessibility"
  ],
  "request_timeout_ms": 6500,
  "only_bundle_ids": [
    "com.apple.Safari",
    "com.apple.SafariTechnologyPreview",
    "org.mozilla.firefox",
    "org.mozilla.firefoxdeveloperedition",
    "com.google.Chrome",
    "com.google.Chrome.canary",
    "com.google.Chrome.beta",
    "com.google.Chrome.dev",
    "org.chromium.Chromium",
    "com.brave.Browser",
    "com.brave.Browser.beta",
    "com.brave.Browser.nightly",
    "com.microsoft.edgemac",
    "com.microsoft.edgemac.Beta",
    "com.microsoft.edgemac.Dev",
    "com.microsoft.edgemac.Canary",
    "company.thebrowser.Browser",
    "com.vivaldi.Vivaldi",
    "com.operasoftware.Opera",
    "com.operasoftware.OperaNext",
    "com.operasoftware.OperaDeveloper"
  ],
  "only_urls": [
    "https://mail.google.com/*"
  ],
  "source_actions": [
    "resource_archive",
    "resource_next",
    "resource_previous"
  ],
  "mappings": {
    "priority": 80,
    "items": [
      {
        "key": "gi",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,i"
        ]
      },
      {
        "key": "gs",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,s"
        ]
      },
      {
        "key": "gb",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,b"
        ]
      },
      {
        "key": "gt",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,t"
        ]
      },
      {
        "key": "gd",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,d"
        ]
      },
      {
        "key": "ga",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,a"
        ]
      },
      {
        "key": "gk",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,k"
        ]
      },
      {
        "key": "gl",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,l"
        ]
      },
      {
        "key": "gn",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,n"
        ]
      },
      {
        "key": "gp",
        "command": [
          "flash",
          "send_keys",
          "--keys=g,p"
        ]
      }
    ]
  },
  "help": {
    "topics": [
      {
        "name": "gmail",
        "title": "Gmail",
        "summary": "Gmail source actions and `g...` go-to mappings.",
        "body": "# Gmail\n\nThis bundled plugin applies only when the focused browser URL is `mail.google.com`.\n\nIt maps Gmail's go-to shortcuts in normal mode by sending Gmail's native two-key sequences: `gi` inbox, `gs` starred, `gb` snoozed, `gt` sent mail, `gd` drafts, `ga` all mail, `gk` tasks, `gl` label, `gn` next page, and `gp` previous page.\n\nIt also owns `resource_archive`, `resource_next`, and `resource_previous` on Gmail thread pages by pressing Gmail's accessible toolbar buttons, so those actions do not depend on Gmail keyboard shortcuts being enabled.\n"
      }
    ]
  }
}
