{
  "id": "history",
  "name": "History",
  "version": "0.1.0",
  "description": "Per-browser history and bookmarks. Enabled by default: at launch, when the flashlight opens, and when you leave Firefox or Chrome (at most once a minute, and only when the stores changed) it copies Firefox places.sqlite and Chrome History into its private cache and reads Chrome Bookmarks. Rows stay out of default flashlight results and appear only through their @<browser>.history/.bookmarks source filters or !fh/!fb/!ch/!cb.",
  "sandbox": {},
  "exec": [
    "./flash-plugin-history"
  ],
  "listen": [
    "core:focus.changed",
    "core:session.opened"
  ],
  "bangs": {
    "command": "history",
    "items": [
      {
        "token": "fh",
        "description": "Firefox history: !fh <query>",
        "source": "firefox.history"
      },
      {
        "token": "fb",
        "description": "Firefox bookmarks: !fb <query>",
        "source": "firefox.bookmarks"
      },
      {
        "token": "ch",
        "description": "Chrome history: !ch <query>",
        "source": "chrome.history"
      },
      {
        "token": "cb",
        "description": "Chrome bookmarks: !cb <query>",
        "source": "chrome.bookmarks"
      }
    ]
  },
  "sources": [
    {
      "name": "firefox.history",
      "kind": "default",
      "priority": "normal"
    },
    {
      "name": "firefox.bookmarks",
      "kind": "default",
      "priority": "normal"
    },
    {
      "name": "chrome.history",
      "kind": "default",
      "priority": "normal"
    },
    {
      "name": "chrome.bookmarks",
      "kind": "default",
      "priority": "normal"
    }
  ]
}
