{
  "id": "terminals",
  "name": "Terminals",
  "version": "0.1.0",
  "description": "Declares the terminal emulators Flash applies its terminal rules to and the split shortcuts they bind, and inside them hints tmux panes and links, answers the letter-search grid, exposes the tmux window finder and the tmux session and window commands, and publishes the attached client's session, window and pane.",
  "sandbox": false,
  "exec": [
    "./flash-plugin-terminals"
  ],
  "capabilities": [
    "accessibility",
    "app_control"
  ],
  "priority": 20,
  "only_terminals": true,
  "terminal_emulators": [
    "org.alacritty",
    "io.alacritty",
    "com.apple.Terminal",
    "com.mitchellh.ghostty",
    "com.googlecode.iterm2",
    "net.kovidgoyal.kitty",
    "com.github.wez.wezterm",
    "dev.warp.Warp-Stable",
    "co.zeit.hyperterm",
    "co.zeit.hyper"
  ],
  "hints": {
    "fallback_on_empty": true
  },
  "navigation": [
    "tmux"
  ],
  "status": [
    "session",
    "window",
    "pane"
  ],
  "listen": [
    "core:focus.changed",
    "core:apps.terminated",
    "core:session.opened",
    "core:ax.changed"
  ],
  "sources": [
    {
      "name": "tmux.windows",
      "type": "terminals",
      "kind": "locations",
      "priority": "important"
    }
  ],
  "commands": [
    {
      "command": "tmux",
      "subcommand": "session",
      "description": "Switch the active tmux client to a session by name and raise its terminal."
    },
    {
      "command": "tmux",
      "subcommand": "window",
      "description": "Switch the active tmux client to a session:window target and raise its terminal."
    },
    {
      "command": "tab",
      "subcommand": "select"
    },
    {
      "command": "tab",
      "subcommand": "next"
    },
    {
      "command": "tab",
      "subcommand": "previous"
    },
    {
      "command": "tab",
      "subcommand": "first"
    },
    {
      "command": "tab",
      "subcommand": "last"
    },
    {
      "command": "tab",
      "subcommand": "new"
    },
    {
      "command": "tab",
      "subcommand": "close",
      "confirm": "Close this tmux window?"
    },
    {
      "command": "tab",
      "subcommand": "move_previous"
    },
    {
      "command": "tab",
      "subcommand": "move_next"
    },
    {
      "command": "pane",
      "subcommand": "next"
    },
    {
      "command": "pane",
      "subcommand": "previous"
    },
    {
      "command": "pane",
      "subcommand": "split_vertical"
    },
    {
      "command": "pane",
      "subcommand": "split_horizontal"
    },
    {
      "command": "pane",
      "subcommand": "close",
      "confirm": "Close this tmux pane?"
    },
    {
      "command": "scroll",
      "subcommand": "top"
    },
    {
      "command": "scroll",
      "subcommand": "bottom"
    },
    {
      "command": "app",
      "subcommand": "reload"
    }
  ],
