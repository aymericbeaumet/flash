{
  "contract": "docs/plugin-protocol.md#host--plugin",
  "description": "An explicit refresh requests Wi-Fi authorization even while the startup refresh owns the non-blocking refresh gate.",
  "steps": [
    {
      "send": { "id": 1, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 5000
    },
    {
      "expect_host_rpc": {
        "method": "host.wifi_info",
        "params": { "request_authorization": false }
      },
      "within_ms": 5000,
      "reply": "manual",
      "capture": "startup_wifi"
    },
    {
      "send": {
        "id": 2,
        "method": "perform",
        "params": {
          "kind": "command",
          "command": "network",
          "subcommand": "refresh",
          "args": [],
          "raw": ":network refresh"
        }
      }
    },
    {
      "expect_host_rpc": {
        "method": "host.wifi_info",
        "params": { "request_authorization": true }
      },
      "within_ms": 1000,
      "reply": { "ok": true, "present": false }
    },
    {
      "expect": { "id": 2, "result": { "ok": false } },
      "within_ms": 1000
    },
    {
      "reply_host_rpc": {
        "to": "startup_wifi",
        "result": { "ok": true, "present": false }
      }
    },
    {
      "expect_notification": {
        "method": "status",
        "params": { "segments": { "summary": { "$type": "string", "$min_len": 1 } } }
      },
      "within_ms": 7000
    },
    { "close_stdin": true },
    { "expect_exit": { "code": 0 }, "within_ms": 3000 }
  ]
}
