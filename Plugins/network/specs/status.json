{
  "contract": "docs/plugin-protocol.md#plugin--host",
  "description": "The initial bounded Wi-Fi, routing-table, and counter collection publishes the compact popup-backed network summary by default.",
  "steps": [
    {
      "send": { "id": 1, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 5000
    },
    {
      "expect_host_rpc": { "method": "host.wifi_info", "params": {} },
      "within_ms": 5000,
      "reply": { "ok": true, "present": true, "ssid": "Atelier" }
    },
    {
      "expect_notification": {
        "method": "status",
        "params": {
          "segments": {
            "summary": { "$type": "string", "$min_len": 1 },
            "details": {
              "$contains": "#[fg=colour178]Network#[default]\nWi-Fi: Atelier\n"
            }
          }
        }
      },
      "within_ms": 7000
    },
    { "close_stdin": true },
    { "expect_exit": { "code": 0 }, "within_ms": 3000 }
  ]
}
