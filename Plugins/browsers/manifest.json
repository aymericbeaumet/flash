{
  "id": "browsers",
  "name": "Browsers",
  "version": "0.1.0",
  "description": "Browser tab catalogs and the tab commands a browser performs itself: AppleScript for Chromium-family browsers and Safari, the Accessibility tab strip and session store for Firefox. Per-browser history and bookmarks too: at launch, when the flashlight opens, and when you leave Firefox or Chrome (at most once a minute, and only when the stores changed) it copies Firefox places.sqlite and Chrome History into its private cache and reads Chrome Bookmarks. Those rows stay out of default flashlight results and appear only through their @<browser>.history/.bookmarks source filters or !fh/!fb/!ch/!cb.",
  "exec": [
    "./flash-plugin-browsers"
  ],
  "capabilities": [
    "accessibility",
    "app_control",
    "apple_events"
  ],
  "apple_events_targets": [
    "com.google.Chrome",
    "com.google.Chrome.canary",
    "com.google.Chrome.beta",
    "com.google.Chrome.dev",
    "org.chromium.Chromium",
    "com.brave.Browser",
    "com.brave.Browser.beta",
    "com.brave.Browser.nightly",
    "com.microsoft.edgemac",
    "com.microsoft.edgemac.Beta",
    "com.microsoft.edgemac.Dev",
    "com.microsoft.edgemac.Canary",
    "company.thebrowser.Browser",
    "com.vivaldi.Vivaldi",
    "com.operasoftware.Opera",
    "com.operasoftware.OperaNext",
    "com.operasoftware.OperaDeveloper",
    "com.apple.Safari",
    "com.apple.SafariTechnologyPreview"
  ],
  "navigation": [
    "flash-browser"
  ],
  "priority": 30,
  "only_bundle_ids": [
    "com.google.Chrome",
    "com.google.Chrome.canary",
    "com.google.Chrome.beta",
    "com.google.Chrome.dev",
    "org.chromium.Chromium",
    "com.brave.Browser",
    "com.brave.Browser.beta",
    "com.brave.Browser.nightly",
    "com.microsoft.edgemac",
    "com.microsoft.edgemac.Beta",
    "com.microsoft.edgemac.Dev",
    "com.microsoft.edgemac.Canary",
    "company.thebrowser.Browser",
    "com.vivaldi.Vivaldi",
    "com.operasoftware.Opera",
    "com.operasoftware.OperaNext",
    "com.operasoftware.OperaDeveloper",
    "com.apple.Safari",
    "com.apple.SafariTechnologyPreview",
    "org.mozilla.firefox",
    "org.mozilla.firefoxdeveloperedition",
    "org.mozilla.nightly"
  ],
  "listen": [
    "core:apps.changed",
    "core:apps.launched",
    "core:apps.terminated",
    "core:focus.changed",
    "core:window.focus.changed",
    "core:ax.changed",
    "core:session.opened"
  ],
  "sources": [
    {
      "name": "chrome.tabs",
      "type": "tabs",
      "kind": "locations",
      "priority": "high"
    },
    {
