      "command": "tab",
      "subcommand": "select"
    },
    {
      "command": "tab",
      "subcommand": "next"
    },
    {
      "command": "tab",
      "subcommand": "previous"
    },
    {
      "command": "tab",
      "subcommand": "first"
    },
