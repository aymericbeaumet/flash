{
  "id": "web",
  "name": "Web",
  "version": "0.1.0",
  "description": "Open a web search in the default browser: :web <engine> <query>.",
  "install": "true",
  "start": "exec ./flash-plugin-web",
  "commands": [
    { "command": "web", "subcommand": "google", "description": "Search Google", "_url": "https://www.google.com/search?q=%s" },
    { "command": "web", "subcommand": "ddg", "description": "Search DuckDuckGo", "_url": "https://duckduckgo.com/?q=%s" },
    { "command": "web", "subcommand": "bing", "description": "Search Bing", "_url": "https://www.bing.com/search?q=%s" },
    { "command": "web", "subcommand": "brave", "description": "Search Brave", "_url": "https://search.brave.com/search?q=%s" },
    { "command": "web", "subcommand": "kagi", "description": "Search Kagi", "_url": "https://kagi.com/search?q=%s" },
    { "command": "web", "subcommand": "ecosia", "description": "Search Ecosia", "_url": "https://www.ecosia.org/search?q=%s" },
    { "command": "web", "subcommand": "startpage", "description": "Search Startpage", "_url": "https://www.startpage.com/sp/search?query=%s" },
    { "command": "web", "subcommand": "gh", "description": "Search GitHub repositories", "_url": "https://github.com/search?q=%s&type=repositories" },
    { "command": "web", "subcommand": "ghc", "description": "Search GitHub code", "_url": "https://github.com/search?q=%s&type=code" },
    { "command": "web", "subcommand": "ghi", "description": "Search GitHub issues", "_url": "https://github.com/search?q=%s&type=issues" },
    { "command": "web", "subcommand": "gitlab", "description": "Search GitLab", "_url": "https://gitlab.com/search?search=%s" },
    { "command": "web", "subcommand": "so", "description": "Search Stack Overflow", "_url": "https://stackoverflow.com/search?q=%s" },
    { "command": "web", "subcommand": "mdn", "description": "Search MDN", "_url": "https://developer.mozilla.org/en-US/search?q=%s" },
    { "command": "web", "subcommand": "devdocs", "description": "Search DevDocs", "_url": "https://devdocs.io/#q=%s" },
    { "command": "web", "subcommand": "caniuse", "description": "Search Can I Use", "_url": "https://caniuse.com/?search=%s" },
    { "command": "web", "subcommand": "npm", "description": "Search npm", "_url": "https://www.npmjs.com/search?q=%s" },
    { "command": "web", "subcommand": "crates", "description": "Search crates.io", "_url": "https://crates.io/search?q=%s" },
    { "command": "web", "subcommand": "docsrs", "description": "Search docs.rs", "_url": "https://docs.rs/releases/search?query=%s" },
    { "command": "web", "subcommand": "pypi", "description": "Search PyPI", "_url": "https://pypi.org/search/?q=%s" },
    { "command": "web", "subcommand": "pkggo", "description": "Search pkg.go.dev", "_url": "https://pkg.go.dev/search?q=%s" },
    { "command": "web", "subcommand": "rubygems", "description": "Search RubyGems", "_url": "https://rubygems.org/search?query=%s" },
    { "command": "web", "subcommand": "packagist", "description": "Search Packagist", "_url": "https://packagist.org/?query=%s" },
    { "command": "web", "subcommand": "maven", "description": "Search Maven Central", "_url": "https://search.maven.org/search?q=%s" },
    { "command": "web", "subcommand": "hex", "description": "Search Hex.pm", "_url": "https://hex.pm/packages?search=%s" },
    { "command": "web", "subcommand": "nixpkgs", "description": "Search Nixpkgs", "_url": "https://search.nixos.org/packages?query=%s" },
    { "command": "web", "subcommand": "brewformula", "description": "Search Homebrew formulae", "_url": "https://formulae.brew.sh/search/?q=%s" },
    { "command": "web", "subcommand": "dockerhub", "description": "Search Docker Hub", "_url": "https://hub.docker.com/search?q=%s" },
    { "command": "web", "subcommand": "wiki", "description": "Search Wikipedia", "_url": "https://en.wikipedia.org/w/index.php?search=%s" },
    { "command": "web", "subcommand": "wolfram", "description": "Search Wolfram Alpha", "_url": "https://www.wolframalpha.com/input?i=%s" },
    { "command": "web", "subcommand": "archwiki", "description": "Search the Arch Wiki", "_url": "https://wiki.archlinux.org/index.php?search=%s" },
    { "command": "web", "subcommand": "scholar", "description": "Search Google Scholar", "_url": "https://scholar.google.com/scholar?q=%s" },
    { "command": "web", "subcommand": "translate", "description": "Translate with Google Translate", "_url": "https://translate.google.com/?sl=auto&tl=en&text=%s" },
    { "command": "web", "subcommand": "define", "description": "Define a word (Merriam-Webster)", "_url": "https://www.merriam-webster.com/dictionary/%s" },
    { "command": "web", "subcommand": "yt", "description": "Search YouTube", "_url": "https://www.youtube.com/results?search_query=%s" },
    { "command": "web", "subcommand": "reddit", "description": "Search Reddit", "_url": "https://www.reddit.com/search/?q=%s" },
    { "command": "web", "subcommand": "hn", "description": "Search Hacker News", "_url": "https://hn.algolia.com/?q=%s" },
    { "command": "web", "subcommand": "x", "description": "Search X / Twitter", "_url": "https://twitter.com/search?q=%s" },
    { "command": "web", "subcommand": "spotify", "description": "Search Spotify", "_url": "https://open.spotify.com/search/%s" },
    { "command": "web", "subcommand": "images", "description": "Search Google Images", "_url": "https://www.google.com/search?tbm=isch&q=%s" },
    { "command": "web", "subcommand": "gif", "description": "Search GIPHY", "_url": "https://giphy.com/search/%s" },
    { "command": "web", "subcommand": "amazon", "description": "Search Amazon", "_url": "https://www.amazon.com/s?k=%s" },
    { "command": "web", "subcommand": "maps", "description": "Search Google Maps", "_url": "https://www.google.com/maps/search/%s" }
  ]
}
