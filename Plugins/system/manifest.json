{
  "id": "system",
  "name": "System",
  "version": "0.1.0",
  "description": "macOS system actions: lock, sleep, restart, shutdown, logout, empty trash, dark mode, and screen saver.",
  "sandbox": {
    "exec": [
      "/usr/bin/osascript",
      "/usr/bin/pmset"
    ],
    "appleevents": true,
    "mach": [
      "com.apple.PowerManagement.control"
    ]
  },
  "exec": [
    "./flash-plugin-system"
  ],
  "commands": [
    {
      "command": "system",
      "description": "Show system action usage"
    },
    {
      "command": "system",
      "subcommand": "lock",
      "description": "Lock the screen"
    },
    {
      "command": "system",
      "subcommand": "sleep",
      "description": "Put the machine to sleep"
    },
    {
      "command": "system",
      "subcommand": "displaysleep",
      "description": "Turn the display off"
    },
    {
      "command": "system",
      "subcommand": "restart",
      "description": "Restart the machine"
    },
    {
      "command": "system",
      "subcommand": "shutdown",
      "description": "Shut down the machine"
    },
    {
      "command": "system",
      "subcommand": "logout",
      "description": "Log out of macOS"
    },
    {
      "command": "system",
      "subcommand": "trash",
      "description": "Empty the Trash"
    },
    {
      "command": "system",
      "subcommand": "dark",
      "description": "Toggle dark mode"
    },
    {
      "command": "system",
      "subcommand": "screensaver",
      "description": "Start the screen saver"
    }
  ],
  "sources": [
    {
      "name": "system.actions",
      "priority": "normal"
    }
  ],
  "capabilities": [
    "accessibility",
    "open"
  ]
}
