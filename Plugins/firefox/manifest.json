{
  "id": "firefox",
  "name": "firefox",
  "version": "0.1.0",
  "description": "Surface Firefox tabs in the flashlight (AX-backed) and handle Firefox source actions (tab_select).",
  "install": "true",
  "start": "exec ./flash-plugin-firefox",
  "priority": 30,
  "capabilities": [
    "accessibility"
  ],
  "only_bundle_ids": [
    "org.mozilla.firefox",
    "org.mozilla.firefoxdeveloperedition"
  ],
  "listen": [
    "core:flash.started",
    "core:apps.snapshot",
    "core:focus.changed",
    "core:ax.changed"
  ],
  "sources": [
    {
      "name": "firefox.tabs",
      "kind": "browser_tabs"
    }
  ],
  "source_actions": [
    "tab_select"
  ]
}
