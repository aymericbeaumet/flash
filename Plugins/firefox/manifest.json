{
  "manifest_version": 1,
  "id": "firefox",
  "name": "firefox",
  "version": "0.1.0",
  "description": "Provides Firefox source-action fallbacks via the core AX broker.",
  "install": "true",
  "start": "exec ./flash-plugin-firefox",
  "priority": 30,
  "bundle_ids": ["org.mozilla.firefox", "org.mozilla.firefoxdeveloperedition"],
  "providers": [
    { "kind": "source_actions", "actions": ["tab_select"] }
  ]
}
