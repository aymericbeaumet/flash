{
  "id": "probe",
  "name": "Wire Probe",
  "version": "0.1.0",
  "description": "Wire-protocol probe: a test fixture the SDK's cargo tests drive in-process over the wire, never shipped or spawned by the host.",
  "exec": [
    "./flash_plugin_probe"
  ],
  "capabilities": [
    "accessibility",
    "app_control",
    "apple_events",
    "network_fetch",
    "open"
  ],
  "fetch_urls": [
    "https://example.com/"
  ],
  "apple_events_targets": [
    "com.example.app"
  ],
  "listen": [
    "core:*"
  ],
  "sources": [
    {
      "name": "probe.items",
      "type": "probes"
    }
  ],
  "query": {},
  "commands": [
    {
      "command": "probe",
      "subcommand": "*",
      "description": "Catch-all probe dispatch; the subcommand routes the probe behavior"
    }
  ],
  "hints": {},
  "navigation": [
    "probe"
  ],
  "status": [
    "state"
  ]
}
