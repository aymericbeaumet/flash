{
  "id": "slack",
  "name": "Slack",
  "version": "0.1.0",
  "description": "Slack CLI actions.",
  "sandbox": {
    "exec": [
      "slack"
    ]
  },
  "exec": [
    "./flash-plugin-slack"
  ],
  "capabilities": [
    "network"
  ],
  "commands": [
    {
      "command": "slack",
      "subcommand": "login",
      "description": "Authenticate the Slack CLI",
      "timeout_ms": 310000
    },
    {
      "command": "slack",
      "subcommand": "version",
      "description": "Show Slack CLI version"
    },
    {
      "command": "slack",
      "subcommand": "run",
      "description": "Run slack with raw arguments"
    }
  ],
  "only_bundle_ids": [
    "com.tinyspeck.slackmacgap",
    "com.tinyspeck.slackmacgap.direct"
  ]
}
