{
  "id": "slack",
  "name": "Slack",
  "version": "0.1.0",
  "description": "Slack CLI actions and a channel finder backed by local Slack app state plus AX fallback.",
  "install": "true",
  "start": "exec ./flash-plugin-slack",
  "capabilities": [
    "accessibility"
  ],
  "commands": {
    "items": [
      {
        "command": "slack",
        "subcommand": "login",
        "description": "Authenticate the Slack CLI"
      },
      {
        "command": "slack",
        "subcommand": "version",
        "description": "Show Slack CLI version"
      },
      {
        "command": "slack",
        "subcommand": "run",
        "description": "Run slack with raw arguments"
      }
    ]
  },
  "only_bundle_ids": [
    "com.tinyspeck.slackmacgap",
    "com.tinyspeck.slackmacgap.direct"
  ],
  "listen": [
    "core:apps.*",
    "core:focus.changed",
    "core:ax.changed",
    "core:apps.snapshot",
    "core:config.*"
  ],
  "sources": [
    "slack.channels"
  ]
}
