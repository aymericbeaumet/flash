{
  "id": "slack",
  "name": "Slack",
  "version": "0.1.0",
  "description": "Slack CLI actions backed by the Slack developer CLI.",
  "install": "true",
  "start": "exec ./flash-plugin-slack",
  "events": [
    { "match": "apps.*", "bundle_ids": ["com.tinyspeck.slackmacgap"] },
    "config.*"
  ],
  "commands": [
    { "command": "slack", "subcommand": "login", "description": "Authenticate the Slack CLI" },
    { "command": "slack", "subcommand": "version", "description": "Show Slack CLI version" },
    { "command": "slack", "subcommand": "run", "description": "Run slack with raw arguments" }
  ]
}
