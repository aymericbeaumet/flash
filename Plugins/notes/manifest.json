{
  "id": "notes",
  "name": "Notes",
  "version": "0.1.0",
  "description": "Surface macOS Notes entries in flashlight, plus `:notes` open helper.",
  "install": "true",
  "start": "exec ./flash-plugin-notes",
  "priority": 12,
  "subscriptions": [
    "core:flash.started",
    "core:config.*",
    { "match": "core:apps.*", "bundle_ids": ["com.apple.Notes"] }
  ],
  "providers": [
    { "kind": "candidates" },
    {
      "kind": "commands",
      "commands": [
        { "command": "notes", "subcommand": "open", "description": "Open Notes.app" },
        { "command": "notes", "subcommand": "refresh", "description": "Refresh the cached notes list" }
      ]
    }
  ]
}
