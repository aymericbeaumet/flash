{
  "id": "processes",
  "name": "Processes",
  "version": "0.1.0",
  "description": "List running processes in flashlight; SIGTERM them with !kill <pid|name>.",
  "install": "true",
  "exec": ["./flash-plugin-processes"],
  "capabilities": [
    "subprocess"
  ],
  "commands": {
    "items": [
      {
        "command": "processes",
        "subcommand": "refresh",
        "description": "Refresh the process list"
      }
    ]
  },
  "shebangs": {
    "command": "processes",
    "items": [
      {
        "token": "kill",
        "description": "Kill a process: !kill <pid|name>",
        "candidate_source": "processes.processes"
      }
    ]
  },
  "listen": [
    "core:apps.launched",
    "core:apps.terminated"
  ],
  "sources": [
    {
      "name": "processes.processes",
      "priority": "normal"
    }
  ]
}
