{
  "id": "processes",
  "name": "Processes",
  "version": "0.1.0",
  "description": "List and terminate running processes, and publish live focused-app resource details and top-process tables for status surfaces.",
  "exec": [
    "./flash-plugin-processes"
  ],
  "sandbox": {},
  "commands": [
    {
      "command": "processes",
      "subcommand": "refresh",
      "description": "Refresh the process list"
    }
  ],
  "listen": [
    "core:apps.launched",
    "core:apps.terminated",
    "core:focus.changed",
    "core:session.opened",
    "core:status.observed"
  ],
  "status": [
    "focused_app_details",
    "top_cpu",
    "top_mem"
  ],
  "sources": [
    {
      "name": "processes.processes",
      "priority": "normal"
    }
  ],
  "capabilities": [
    "app_control",
    "process_control"
  ],
  "bangs": {
    "command": "processes",
    "items": [
      {
        "token": "kill",
        "description": "Kill a process: !kill <pid|name>",
        "source": "processes.processes"
      }
    ]
  }
}
