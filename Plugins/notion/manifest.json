{
  "id": "notion",
  "name": "Notion",
  "version": "0.1.0",
  "description": "Notion API and worker actions backed by ntn.",
  "install": "true",
  "start": "exec ./flash-plugin-notion",
  "events": [
    "config.*"
  ],
  "providers": [
    {
      "kind": "commands",
      "commands": [
        { "command": "notion", "subcommand": "login", "description": "Authenticate ntn" },
        { "command": "notion", "subcommand": "version", "description": "Show ntn version" },
        { "command": "notion", "subcommand": "api", "description": "Run a Notion API request" },
        { "command": "notion", "subcommand": "workers", "description": "Run a Notion Workers command" },
        { "command": "notion", "subcommand": "run", "description": "Run ntn with raw arguments" }
      ]
    }
  ]
}
