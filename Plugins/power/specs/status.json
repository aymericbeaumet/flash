{
  "contract": "docs/plugin-protocol.md#plugin--host",
  "description": "The one-second charge collector and periodic/event-driven health refresh publish the compact popup-backed power summary, while an explicit refresh returns cached details within the perform deadline.",
  "steps": [
    {
      "send": { "id": 1, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 5000
    },
    {
      "expect_notification": {
        "method": "status",
        "params": {
          "segments": {
            "summary": { "$contains": "#[popup=inline:" },
            "label": { "$contains": "#[fg=#EBCB8B]BAT#[default]" },
            "details": { "$contains": "#[fg=colour245]Charge        #[default]" }
          }
        }
      },
      "within_ms": 7000
    },
    {
      "send": {
        "id": 2,
        "method": "perform",
        "params": {
          "kind": "command",
          "command": "power",
          "subcommand": "refresh",
          "args": [],
          "raw": ":power refresh"
        }
      }
    },
    {
      "expect": {
        "id": 2,
        "result": {
          "ok": true,
          "message": { "$contains": "Charge:" }
        }
      },
      "within_ms": 7000
    },
    { "close_stdin": true },
    { "expect_exit": { "code": 0 }, "within_ms": 3000 }
  ]
}
