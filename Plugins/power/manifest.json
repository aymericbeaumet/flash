{
  "id": "power",
  "name": "Power",
  "version": "0.1.0",
  "description": "Publish compact battery charge with power, health, and estimate details on hover; summary_mode=full restores the estimate inline.",
  "sandbox": {
    "exec": [
      "/usr/bin/pmset",
      "/usr/sbin/ioreg"
    ],
    "mach": [
      "com.apple.PowerManagement.control"
    ]
  },
  "exec": [
    "./flash-plugin-power"
  ],
  "commands": [
    {
      "command": "power",
      "subcommand": "",
      "description": "Show current battery and power details"
    },
    {
      "command": "power",
      "subcommand": "refresh",
      "description": "Refresh battery and power details"
    }
  ],
  "status": [
    "summary",
    "details"
  ],
  "listen": [
    "core:power.changed"
  ]
}
