{
  "id": "memory",
  "name": "Memory",
  "version": "0.1.0",
  "description": "Publish fixed-width memory usage with allocation, swap, and history details on hover; summary_mode=full restores history inline.",
  "exec": [
    "./flash-plugin-memory"
  ],
  "commands": [
    {
      "command": "memory",
      "subcommand": "",
      "description": "Show the latest memory snapshot"
    },
    {
      "command": "memory",
      "subcommand": "refresh",
      "description": "Refresh memory status immediately"
    }
  ],
  "status": [
    "summary",
    "details"
  ],
  "sandbox": {
    "exec": [
      "/usr/bin/vm_stat",
      "/usr/sbin/sysctl"
    ]
  }
}
