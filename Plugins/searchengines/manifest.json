{
  "manifest_version": 1,
  "id": "searchengines",
  "name": "Search Engines",
  "version": "0.1.0",
  "description": "DuckDuckGo-style bangs in the flashlight: type !<bang> <query> to search, e.g. !r cat opens a Reddit search.",
  "install": "true",
  "start": "exec ./flash-plugin-searchengines",
  "providers": [
    {
      "kind": "shebang",
      "command": "searchengines",
      "shebangs": [
        { "token": "*", "description": "DuckDuckGo bang: !<bang> <query>" }
      ]
    }
  ]
}
