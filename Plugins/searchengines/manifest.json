{
  "id": "searchengines",
  "name": "Search Engines",
  "version": "0.1.0",
  "description": "DuckDuckGo-style bangs in the flashlight: type !<bang> <query> to search, e.g. !r cat opens a Reddit search.",
  "sandbox": {},
  "exec": [
    "./flash-plugin-searchengines"
  ],
  "shebangs": {
    "command": "searchengines",
    "items": [
      {
        "token": "*",
        "description": "DuckDuckGo bang: !<bang> <query>"
      }
    ]
  },
  "sources": [
    {
      "name": "searchengines.bangs",
      "priority": "normal"
    }
  ],
  "capabilities": [
    "open"
  ]
}
