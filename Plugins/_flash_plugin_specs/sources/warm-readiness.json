{
  "contract": "docs/plugin-protocol.md#lifecycle-methods",
  "requires": ["sources_warm"],
  "description": "The warm-catalog contract: a sources plugin replies to initialize only once its canonical catalog exists, so the first sources.snapshot answers from memory — every row titled with its manifest-declared metadata.source. An authoritative-empty catalog is legal (deliberately no minimum row count: netinfo on a machine with no interfaces, snippets with no configured snippets, and a cleared source are all correct empties).",
  "steps": [
    {
      "send": {
        "id": 1,
        "method": "initialize",
        "params": {
          "plugin_id": "${plugin_id}",
          "version": "0.1.0",
          "protocol_version": 1,
          "running_applications": []
        }
      }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 15000
    },
    { "send": { "id": 2, "method": "sources.snapshot", "params": {} } },
    {
      "expect": {
        "id": 2,
        "result": {
          "candidates": {
            "$type": "array",
            "$each": {
              "title": { "$type": "string", "$min_len": 1 },
              "metadata": { "source": { "$type": "string", "$min_len": 1 } }
            }
          }
        }
      },
      "within_ms": 1500
    },
    { "send": { "id": 3, "method": "shutdown", "params": {} } },
    { "expect": { "id": 3, "result": { "ok": true } }, "within_ms": 5000 }
  ]
}
