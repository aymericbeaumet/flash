{
  "contract": "docs/plugin-protocol.md#host--plugin",
  "description": "The lifecycle every plugin must speak: initialize replies immediately echoing protocol version 1 (no warm-catalog wait — on_start runs after the reply), ping answers ok, a repeated initialize is NAK'd with the canonical string while the plugin keeps serving, an event notification full of doubles (incl. a negative window origin, exactly what the host emits for a display left of the primary) is absorbed without a reply, an unknown id'd request is never silently dropped, and stdin EOF is the shutdown signal: cleanup, exit 0.",
  "steps": [
    {
      "send": { "id": 1, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 5000
    },
    { "send": { "id": 2, "method": "ping", "params": {} } },
    { "expect": { "id": 2, "result": { "ok": true } }, "within_ms": 5000 },
    {
      "send": { "id": 3, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": {
        "id": 3,
        "result": { "ok": false, "error": "initialize may only be called once" }
      },
      "within_ms": 5000
    },
    {
      "send": {
        "method": "event",
        "params": {
          "name": "core:window.focus.changed",
          "payload": {
            "bundle_id": "dev.flash.spec",
            "pid": 999,
            "front_window_frame": {
              "x": -1912.5,
              "y": -140.25,
              "width": 1512.0,
              "height": 982.0
            }
          }
        }
      }
    },
    {
      "send": {
        "id": 7,
        "method": "driver.unknown",
        "params": { "x": -1912.5, "y": 982.0 }
      }
    },
    {
      "expect": {
        "id": 7,
        "result": { "ok": false, "error": "unknown method: driver.unknown" }
      },
      "within_ms": 5000
    },
    { "send": { "id": 8, "method": "ping", "params": {} } },
    { "expect": { "id": 8, "result": { "ok": true } }, "within_ms": 5000 },
    { "close_stdin": true },
    { "expect_exit": { "code": 0 }, "within_ms": 3000 }
  ]
}
