{
  "contract": "docs/plugin-protocol.md#host--plugin",
  "requires": ["queries"],
  "description": "The evaluator contract's wire half: evaluate always answers {ok, answers} — an empty array for input the evaluator does not claim (evaluators are additive parsers, never error paths) — and every answer stays inside the closed {title, subtitle?, effect} shape with no URL or metadata keys. Latency budgets are host-enforced; this spec asserts shape, not the 50 ms deadline.",
  "steps": [
    {
      "send": { "id": 1, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 5000
    },
    {
      "send": {
        "id": 4,
        "method": "evaluate",
        "params": {
          "surface": "flashlight",
          "scope": "",
          "query": "zzzz@@@@spec-probe"
        }
      }
    },
    {
      "expect": {
        "id": 4,
        "result": {
          "ok": true,
          "answers": {
            "$type": "array",
            "$each": {
              "title": { "$type": "string" },
              "effect": { "type": { "$type": "string" } },
              "url": { "$absent": true },
              "metadata": { "$absent": true }
            }
          }
        }
      },
      "within_ms": 2000
    },
    { "close_stdin": true },
    { "expect_exit": { "code": 0 }, "within_ms": 3000 }
  ]
}
