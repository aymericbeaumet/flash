    },
    {
      "send": {
        "id": 111,
        "method": "perform",
        "params": {
          "kind": "command",
          "command": "conformance",
          "subcommand": "activate",
          "args": [],
          "raw": ":conformance activate"
        }
      }
    },
    {
      "expect": {
        "id": 111,
        "result": {
          "ok": true,
          "message": {
            "$contains": "\"ok\":true"
          }
        }
      },
      "within_ms": 5000
    },
    {
      "send": {
        "id": 112,
        "method": "perform",
        "params": {
          "kind": "command",
          "command": "conformance",
          "subcommand": "normal-mode-target",
          "args": [],
          "raw": ":conformance normal-mode-target"
        }
      }
    },
    {
      "expect": {
        "id": 112,
        "result": {
          "ok": true,
          "message": {
            "$contains": "\"ok\":true"
          }
        }
      },
      "within_ms": 5000
    },
    {
      "close_stdin": true
    },
    {
      "expect_exit": {
        "code": 0
      },
      "within_ms": 3000
    }
  ]
}
