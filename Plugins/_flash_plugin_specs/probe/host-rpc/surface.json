        "params": {
          "kind": "command",
          "command": "conformance",
          "subcommand": "ps",
          "args": [],
          "raw": ":conformance ps"
        }
      }
    },
    {
      "expect": {
        "id": 107,
        "result": {
          "ok": true,
          "message": {
            "$contains": "\"ok\":true"
          }
        }
      },
      "within_ms": 5000
    },
    {
      "send": {
        "id": 108,
        "method": "perform",
        "params": {
          "kind": "command",
          "command": "conformance",
          "subcommand": "signal",
          "args": [
            "4242"
          ],
          "raw": ":conformance signal 4242"
        }
      }
    },
    {
      "expect": {
        "id": 108,
        "result": {
          "ok": true,
          "message": {
            "$contains": "\"ok\":true"
          }
        }
      },
      "within_ms": 5000
    },
    {
      "send": {
        "id": 109,
        "method": "perform",
        "params": {
          "kind": "command",
          "command": "conformance",
          "subcommand": "keys",
          "args": [],
