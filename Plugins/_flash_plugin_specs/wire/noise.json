{
  "contract": "docs/plugin-protocol.md#framing",
  "description": "Wire noise must never kill a plugin: blank lines and undecodable lines are ignored, an unknown notification is absorbed, and a response frame whose id the plugin never issued is dropped (host and plugin id counters are independent and may overlap). A follow-up ping proves the process survived it all.",
  "steps": [
    {
      "send": { "id": 1, "method": "initialize", "params": { "protocol_version": 1 } }
    },
    {
      "expect": { "id": 1, "result": { "ok": true, "protocol_version": 1 } },
      "within_ms": 5000
    },
    { "send_raw": "\n" },
    { "send_raw": "this is not json\n" },
    { "send_raw": "{\"truncated\": \n" },
    { "send": { "method": "driver.mystery", "params": { "noise": true } } },
    { "send": { "id": 424242, "result": { "ok": true } } },
    { "send": { "id": 4, "method": "ping", "params": {} } },
    { "expect": { "id": 4, "result": { "ok": true } }, "within_ms": 5000 },
    { "close_stdin": true },
    { "expect_exit": { "code": 0 }, "within_ms": 3000 }
  ]
}
