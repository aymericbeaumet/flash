{
  "id": "github",
  "name": "GitHub",
  "version": "0.1.0",
  "description": "GitHub issue and pull request actions backed by gh.",
  "install": "true",
  "start": "exec ./flash-plugin-github",
  "events": [
    "config.*"
  ],
  "commands": [
    { "command": "github", "subcommand": "login", "description": "Authenticate gh" },
    { "command": "github", "subcommand": "status", "description": "Show gh authentication status" },
    { "command": "github", "subcommand": "issues", "description": "List GitHub issues" },
    { "command": "github", "subcommand": "prs", "description": "List GitHub pull requests" },
    { "command": "github", "subcommand": "run", "description": "Run gh with raw arguments" }
  ]
}
