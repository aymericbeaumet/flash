{
  "id": "snippets",
  "name": "Snippets",
  "version": "0.1.0",
  "description": "User-defined text snippets typed into the focused app via @snippets.",
  "exec": [
    "./flash-plugin-snippets"
  ],
  "lifecycle": "publish_then_exit",
  "watch_settings": [
    "file"
  ],
  "sources": [
    {
      "name": "snippets.items",
      "type": "snippets",
      "priority": "normal"
    }
  ]
}
