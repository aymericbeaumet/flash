          "type": "string"
        }
      },
      "required": []
    },
    "clock_minute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "weekday": {
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ]
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "late_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "date",
        "late_seconds",
        "time",
        "weekday"
      ]
    },
    "workspace_changed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "type": "string"
        },
        "previous": {
          "type": "string"
        },
        "workspaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "workspace",
        "workspaces"
      ]
    },
    "mode_changed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "description": "normal, insert, command, terminal, hyper, hold, visual, disabled, or the name of the active layer."
        },
        "previous": {
          "type": "string",
          "description": "normal, insert, command, terminal, hyper, hold, visual, disabled, or the name of the active layer."
        }
      },
      "required": [
        "mode",
        "previous"
      ]
    },
    "hints_shown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "description": "targets, screen, words, scroll, grid, bigram, positions, screens, mouse_dock, mouse_menubar, mouse_notifications or window_switcher."
        },
        "targets": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "surface",
        "targets"
      ]
    },
    "hints_committed": {
      "type": "object",
