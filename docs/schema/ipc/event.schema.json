{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/ipc/event.schema.json",
  "title": "event",
  "description": "Resident to client: one host event a subscription names. Payloads describe Flash and the apps it sees; never keys, typed text, clipboard content, window titles or a hint's target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "seq",
    "name",
    "time_ms",
    "payload"
  ],
  "properties": {
    "type": {
      "const": "event"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "One sequence for every subscriber of this resident: a gap is an event this client did not ask for, or one its queue coalesced."
    },
    "name": {
      "enum": [
        "core:apps.launched",
        "core:apps.terminated",
        "core:focus.changed",
        "core:window.focus.changed",
        "core:config.changed",
        "core:power.changed",
        "core:network.changed",
        "core:volumes.changed",
        "core:system.slept",
        "core:system.woke",
        "core:displays.slept",
        "core:displays.woke",
        "core:screen.locked",
        "core:screen.unlocked",
        "core:displays.changed",
        "core:space.changed",
        "core:user.idle",
        "core:user.active",
        "core:usb.attached",
        "core:usb.detached",
        "core:clock.minute",
        "core:workspace.changed",
        "core:mode.changed",
        "core:hints.shown",
        "core:hints.committed",
        "core:hints.cancelled",
        "core:monitor.triggered"
      ]
    },
    "time_ms": {
      "type": "integer",
      "description": "When it was emitted, in milliseconds since 1970."
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "name": {
