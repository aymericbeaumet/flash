      ]
    },
    "hints_cancelled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface": {
          "type": "string",
          "description": "targets, screen, words, scroll, grid, bigram, positions, screens, mouse_dock, mouse_menubar, mouse_notifications or window_switcher."
        }
      },
      "required": [
        "surface"
      ]
    },
    "monitor_triggered": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monitor": {
          "type": "string"
        },
        "level": {
          "enum": [
            "warning",
            "error"
          ]
        }
      },
      "required": [
        "level",
        "monitor"
      ]
    }
