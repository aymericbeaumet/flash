{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/initialize.reply.schema.json",
  "title": "initialize reply",
  "description": "Plugin to host: the version the plugin speaks. Anything but the success is terminal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "result"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "protocol_version"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "protocol_version": {
              "const": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "error"
          ],
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "type": "string",
              "pattern": "\\S",
              "description": "A content-free reason; never blank."
            },
            "protocol_version": {
              "type": "integer",
              "description": "The plugin's version, on a mismatch."
            }
          }
        }
      ]
    }
  }
}
