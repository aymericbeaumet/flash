{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/host.fetch.schema.json",
  "title": "host.fetch",
  "description": "Plugin to host: GET one https URL inside the plugin's fetch allowlist: the manifest's fetch_urls prefixes and the URLs its fetch_settings hold.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "method",
    "params"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "method": {
      "const": "host.fetch"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https:"
        }
      }
    }
  }
}
