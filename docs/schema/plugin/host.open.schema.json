{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/host.open.schema.json",
  "title": "host.open",
  "description": "Plugin to host: open a URL that is not a local file, or an app by bundle id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "method",
    "params"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "method": {
      "const": "host.open"
    },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(?![Ff][Ii][Ll][Ee]:)[A-Za-z][A-Za-z0-9+.-]*:",
              "description": "An absolute URL of any scheme but file."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundle_id"
          ],
          "properties": {
            "bundle_id": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
