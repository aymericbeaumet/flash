{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/host.wifi_info.reply.schema.json",
  "title": "host.wifi_info reply",
  "description": "Host to plugin: the network name when the host can read one.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "result"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "present"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "present": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "present",
            "ssid"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "present": {
              "const": true
            },
            "ssid": {
              "type": "string"
            }
          }
        },
        {
          "$ref": "definitions.schema.json#/definitions/failure"
        }
      ]
    }
  }
}
