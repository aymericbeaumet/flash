{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/text_grid.reply.schema.json",
  "title": "text_grid reply",
  "description": "Plugin to host: the grid, or a failure the host serves as none. No lines means no grid; one malformed line rejects the whole reply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "result"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "columns",
            "rows",
            "lines"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "columns": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "rows": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "lines": {
              "type": "array",
              "items": {
                "$ref": "definitions.schema.json#/definitions/text_grid_line"
              }
            }
          }
        },
        {
          "$ref": "definitions.schema.json#/definitions/failure"
        }
      ]
    }
  }
}
