{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/host.wifi_info.schema.json",
  "title": "host.wifi_info",
  "description": "Plugin to host: the current Wi-Fi network name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "method",
    "params"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "method": {
      "const": "host.wifi_info"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_authorization"
      ],
      "properties": {
        "request_authorization": {
          "type": "boolean",
          "description": "Whether the host may show the Location prompt the name needs."
        }
      }
    }
  }
}
