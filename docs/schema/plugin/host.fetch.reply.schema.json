{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/host.fetch.reply.schema.json",
  "title": "host.fetch reply",
  "description": "Host to plugin: the response as UTF-8 text, or why there is none.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "result"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "status",
            "body"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "status": {
              "type": "integer"
            },
            "body": {
              "type": "string",
              "$comment": "At most 1048576 bytes."
            }
          }
        },
        {
          "$ref": "definitions.schema.json#/definitions/failure"
        }
      ]
    }
  }
}
