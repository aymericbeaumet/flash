{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/text_grid.schema.json",
  "title": "text_grid",
  "description": "Host to plugin: the focused app whose text grid a declared hint provider reads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "method",
    "params",
    "deadline_ms"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "method": {
      "const": "text_grid"
    },
    "params": {
      "$ref": "definitions.schema.json#/definitions/spatial_context"
    },
    "deadline_ms": {
      "$ref": "definitions.schema.json#/definitions/deadline_ms"
    },
    "trace": {
      "$ref": "definitions.schema.json#/definitions/trace"
    }
  }
}
