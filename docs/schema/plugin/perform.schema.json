{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/perform.schema.json",
  "title": "perform",
  "description": "Host to plugin: resolve a committed row, run a command, or navigate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "method",
    "params",
    "deadline_ms"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "method": {
      "const": "perform"
    },
    "params": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "row"
          ],
          "properties": {
            "kind": {
              "const": "resolve"
            },
            "row": {
              "$ref": "definitions.schema.json#/definitions/row"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command",
            "subcommand",
            "args"
          ],
          "properties": {
            "kind": {
              "const": "command"
            },
            "command": {
              "type": "string"
            },
            "subcommand": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "context": {
              "$ref": "definitions.schema.json#/definitions/context"
            }
          },
          "$comment": "context comes with a core command the manifest declares under one of Flash's topics, never with the plugin's own command or a bang."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "navigate"
            },
            "url": {
              "type": "string"
            }
          }
        }
      ]
    },
    "deadline_ms": {
      "$ref": "definitions.schema.json#/definitions/deadline_ms"
    },
    "trace": {
      "$ref": "definitions.schema.json#/definitions/trace"
    }
  }
}
