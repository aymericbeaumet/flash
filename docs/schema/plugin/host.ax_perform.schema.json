{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/host.ax_perform.schema.json",
  "title": "host.ax_perform",
  "description": "Plugin to host: perform an accessibility action on a snapshot node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "method",
    "params"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "method": {
      "const": "host.ax_perform"
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle"
      ],
      "properties": {
        "handle": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "description": "AXPress when absent."
        }
      }
    }
  }
}
