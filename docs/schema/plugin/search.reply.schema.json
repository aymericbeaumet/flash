{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/aymericbeaumet/flash/main/docs/schema/plugin/search.reply.schema.json",
  "title": "search reply",
  "description": "Plugin to host: the rows of the source that was asked for, or a failure the host serves as none. One malformed or over-quota row, or a row of another source, rejects the whole reply.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "result"
  ],
  "properties": {
    "id": {
      "$ref": "definitions.schema.json#/definitions/id"
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "rows"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "rows": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "$ref": "definitions.schema.json#/definitions/row"
              },
              "$comment": "At most 4194304 bytes in its compact encoding. Every row carries the request's source."
            }
          }
        },
        {
          "$ref": "definitions.schema.json#/definitions/failure"
        }
      ]
    }
  }
}
