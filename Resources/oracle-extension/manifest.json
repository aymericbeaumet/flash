{
  "manifest_version": 2,
  "name": "Flash Oracle",
  "version": "0.1.0",
  "description": "Exfiltrates Vimium-FF hint anchors via document.title for the Flash AX parity oracle.",
  "browser_specific_settings": {
    "gecko": {
      "id": "flash-oracle@flash.local",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "match_about_blank": true,
      "all_frames": false,
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
