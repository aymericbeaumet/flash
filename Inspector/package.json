    "marked": "^18.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
