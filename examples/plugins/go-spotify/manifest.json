{
  "id": "go-spotify",
  "name": "Spotify (Go)",
  "version": "0.1.0",
  "description": "Go port of the bundled spotify plugin — compiled by the sandboxed third-party install step, driven via :go-spotify <subcommand>.",
  "install": "go build -o flash-plugin-go-spotify .",
  "exec": ["./flash-plugin-go-spotify"],
  "commands": {
    "items": [
      { "command": "go-spotify", "subcommand": "login", "description": "Authenticate spotify_player" },
      { "command": "go-spotify", "subcommand": "status", "description": "Show spotify_player version" },
      { "command": "go-spotify", "subcommand": "pause", "description": "Pause playback" },
      { "command": "go-spotify", "subcommand": "play", "description": "Resume playback" },
      { "command": "go-spotify", "subcommand": "toggle", "description": "Toggle play/pause" },
      { "command": "go-spotify", "subcommand": "next", "description": "Skip to next track" },
      { "command": "go-spotify", "subcommand": "previous", "description": "Skip to previous track" },
      { "command": "go-spotify", "subcommand": "search", "description": "Search Spotify" }
    ]
  }
}
